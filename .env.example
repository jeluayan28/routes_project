# Copy to .env.local and fill in. Never commit .env.local.
# All values below are PLACEHOLDERS.

# --- Supabase (Project Settings > API Keys / Data API) -----------------------
# Project URL and PUBLISHABLE key. Both are safe for the browser: data access
# is enforced by Row Level Security, not by hiding these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy projects only: the old "anon" JWT key also works under this name.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put a Supabase secret / service_role key in a NEXT_PUBLIC_ variable or
# in any client code. This app does not need one. If a later server-only task
# does, add it WITHOUT the NEXT_PUBLIC_ prefix, read it only in server code
# (e.g. SUPABASE_SECRET_KEY=...), and never commit it.

# --- Local development (supabase start) --------------------------------------
# `npx supabase status` prints the local URL (http://127.0.0.1:54321) and a
# local publishable key to use in .env.local.

# --- App ----------------------------------------------------------------------
# Public site URL, used for metadata. Optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development sample data. When "true", clearly-labelled SAMPLE routes (not real
# Butuan data) come from code, not from the database. Leave unset/false in production.
NEXT_PUBLIC_ENABLE_SAMPLE_DATA=false

# Optional email shown on About and used by "Report incorrect information".
# If empty, the app says no contact has been set up yet.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Map ----------------------------------------------------------------------
# Raster tiles default to OpenStreetMap's public tile server, which is fine for
# development and light use only (https://operations.osmfoundation.org/policies/tiles/).
# For production traffic use a provider whose terms allow it, and set BOTH:
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, tiles by Example
