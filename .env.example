# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and anon/publishable key (safe for the browser;
# access is controlled by Row Level Security, not by hiding this key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for metadata. Optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: Do NOT add the Supabase service-role key here with a NEXT_PUBLIC_ prefix.
# It is not needed in this phase. If a later phase needs it, it must be a
# server-only variable (no NEXT_PUBLIC_ prefix) used only in server code.

# Development sample data. When "true", clearly-labelled SAMPLE routes (not real
# Butuan data) are shown so the UI can be exercised. Leave unset/false otherwise.
NEXT_PUBLIC_ENABLE_SAMPLE_DATA=true

# Optional email shown on About and used by "Report incorrect information".
# If empty, the app says no contact has been set up yet.
NEXT_PUBLIC_CONTACT_EMAIL=
